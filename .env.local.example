# ── Nutri Greenz — environment template ──────────────────────────────
# Copy to .env.local and fill in real values. NEVER commit .env.local.
# NEXT_PUBLIC_* values are exposed to the browser; everything else is server-only.

# ── Admin portal (Milestone 1) ───────────────────────────────────────
ADMIN_EMAIL=admin@nutrigreenz.farm
ADMIN_PASSCODE=
ADMIN_SESSION_SECRET=
STAFF_ADMIN_EMAIL=
STAFF_ADMIN_PASSCODE=

# ── Firebase Authentication (Milestone 2) ────────────────────────────
# From Firebase console → Project settings → Your apps (Web app config):
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# From the service-account JSON (Project settings → Service accounts) — SERVER ONLY:
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ── Supabase — Database + Storage (Milestone 2) ──────────────────────
# Settings → Database → Connection string (pooled 6543 for app, direct 5432 for migrations):
DATABASE_URL=
DIRECT_URL=
# Settings → API:
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Later in Milestone 2 (placeholders for now) ──────────────────────
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# BREVO_API_KEY=
# MSG91_AUTH_KEY=
# NEXT_PUBLIC_GA4_ID=

# Registered GSTIN, printed on invoices and receipts. Leave unset until the real
# number is available — the line is omitted rather than filled with a placeholder,
# because printing a GSTIN the business does not hold is a false declaration on a
# tax document.
SELLER_GSTIN=

# ── SBIePay ───────────────────────────────────────────────────────────────
# Set PAYMENT_PROVIDER=sbiepay to turn online payment on. Until every variable
# below is present the checkout offers Cash on Delivery only — it will not show
# a UPI button that fails after the customer has committed to the order.
PAYMENT_PROVIDER=

# SBI issues exactly three values. Their labels in the credentials email map
# one-to-one onto these names:
#
#   Merchant-API-key-id      -> SBIEPAY_API_KEY_ID
#   Merchant-API-key-secret  -> SBIEPAY_API_KEY_SECRET
#   Encryption-Key           -> SBIEPAY_ENCRYPTION_KEY
#
# There is no separate merchant id — the merchant identity IS the API key id.
# The SECRET authenticates the caller; the ENCRYPTION KEY encrypts the payload
# inside the request. They are not interchangeable, and the bank's error for a
# wrong key does not say which of the two was at fault.
SBIEPAY_API_KEY_ID=
SBIEPAY_API_KEY_SECRET=
SBIEPAY_ENCRYPTION_KEY=

# Which SBI environment to talk to. A NAME, not a URL — the two hosts are
# similar enough to misread, and a typo in a free-text URL could point live
# customer payments at UAT, or point test runs at LIVE and charge a real card.
#
#   integration  https://integration.sbiepay.sbiuat.bank.in   (UAT — start here)
#   live         https://sbiepay.sbi.bank.in                  (real money)
#
# Anything else leaves online payment switched off rather than half-working.
SBIEPAY_ENV=integration
