# ── Nutri Greenz — environment template ──────────────────────────────
# Copy to .env.local and fill in real values. NEVER commit .env.local.
# NEXT_PUBLIC_* values are exposed to the browser; everything else is server-only.

# ── Admin portal (Milestone 1) ───────────────────────────────────────
ADMIN_EMAIL=admin@nutrigreenz.farm
ADMIN_PASSCODE=
ADMIN_SESSION_SECRET=
STAFF_ADMIN_EMAIL=
STAFF_ADMIN_PASSCODE=

# ── Firebase Authentication (Milestone 2) ────────────────────────────
# From Firebase console → Project settings → Your apps (Web app config):
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# From the service-account JSON (Project settings → Service accounts) — SERVER ONLY:
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ── Supabase — Database + Storage (Milestone 2) ──────────────────────
# Settings → Database → Connection string (pooled 6543 for app, direct 5432 for migrations):
DATABASE_URL=
DIRECT_URL=
# Settings → API:
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Later in Milestone 2 (placeholders for now) ──────────────────────
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# BREVO_API_KEY=
# MSG91_AUTH_KEY=
# NEXT_PUBLIC_GA4_ID=

# Registered GSTIN, printed on invoices and receipts. Leave unset until the real
# number is available — the line is omitted rather than filled with a placeholder,
# because printing a GSTIN the business does not hold is a false declaration on a
# tax document.
SELLER_GSTIN=

# ── SBIePay ───────────────────────────────────────────────────────────────
# Set PAYMENT_PROVIDER=sbiepay to turn online payment on. Until every variable
# below is present the checkout offers Cash on Delivery only — it will not show
# a UPI button that fails after the customer has committed to the order.
PAYMENT_PROVIDER=

# From the credentials email. Three different things doing three different jobs;
# mixing the last two is the classic cause of a "decryption failed" error that
# does not say which key was wrong.
#
#   MERCHANT_ID     who the money settles to      (identity, not secret)
#   API_KEY_ID      which API client is calling   (identity, not secret)
#   API_KEY_SECRET  proves the caller is that client — signs the request
#   ENCRYPTION_KEY  the AES working key that encrypts the request payload
SBIEPAY_MERCHANT_ID=
SBIEPAY_API_KEY_ID=
SBIEPAY_API_KEY_SECRET=
SBIEPAY_ENCRYPTION_KEY=

# NOT from the credentials email — this is the endpoint, and it differs between
# UAT and production. Take it from the integration document. Point it at UAT
# until a test transaction has gone through end to end.
SBIEPAY_BASE_URL=
