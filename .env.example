# Firebase Auth (Google Sign-In + Mobile OTP) — Tech Stack §3
# Create a Firebase project, add a Web App, and paste the config values here into .env.local.
# Enable Authentication → Sign-in methods: "Google" and "Phone".
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Phone-OTP provider switch (client + server) ---
# Selects how phone one-time codes are DELIVERED, across storefront, captain and
# admin sign-in:
#   unset / "firebase" (DEFAULT) → Firebase phone auth (reCAPTCHA + ID token)
#   "msg91"                      → MSG91 v5 SMS OTP (server generates + verifies)
# Google sign-in always stays on Firebase. Flip to msg91 ONLY after the MSG91
# vars below are set. Anything but the exact string "msg91" keeps Firebase.
# NEXT_PUBLIC_OTP_PROVIDER=firebase

# MSG91 SMS OTP (SERVER-ONLY) — used when NEXT_PUBLIC_OTP_PROVIDER=msg91. MSG91
# generates, stores and verifies the code; we store none. MSG91_OTP_TEMPLATE_ID
# is the DLT-approved OTP template id from the MSG91 dashboard; the account auth
# key is read from MSG91_AUTH_KEY (or MSG91_AUTHKEY). If either is missing, the
# send route returns a clear 503 "SMS OTP not configured" (never crashes).
# MSG91_OTP_TEMPLATE_ID=
# MSG91_AUTH_KEY=

# Admin portal auth
# Server-validated admin login. The passcode has NO fallback — if ADMIN_PASSCODE
# is unset, every login attempt fails (fail closed). ADMIN_SESSION_SECRET signs
# the httpOnly session cookie; rotate it to invalidate all sessions.
# The ADMIN_* credentials below are the SUPER ADMIN (role "superadmin") — full
# access, including the global config / control center at /admin/config.
ADMIN_EMAIL=admin@nutrigreenz.farm
# Additional addresses accepted at sign-in for the SAME super-admin identity.
# Comma-separated. The session is always issued under ADMIN_EMAIL.
ADMIN_EMAIL_ALIASES=
# Optional: deliver super-admin sign-in codes and passcode resets to this address
# instead of the account address. For use while the domain has no real mailbox.
# Applies ONLY to the super admin, never to staff or DB-backed admins.
ADMIN_MAILBOX_OVERRIDE=
ADMIN_PASSCODE=change-me-strong-passcode
ADMIN_SESSION_SECRET=generate-a-long-random-string

# Fail-closed MFA for the super-admin. When set truthy (1/true/yes/on), a
# superadmin sign-in is REFUSED unless a usable second factor is configured (an
# admin_security row or env ADMIN_TOTP_SECRET). Leave unset in the demo to allow
# passcode-only super-admin login; set ADMIN_REQUIRE_MFA=1 in production so the
# highest-privilege role is never minted on the passcode alone.
# ADMIN_REQUIRE_MFA=1

# Staff admin (OPTIONAL — role "admin"). A limited staff-admin login that can
# use the dashboard but NOT the super-admin-only /admin/config control center.
# Both vars must be set for staff login to work; if either is unset, staff login
# fails closed (no auth hole). Super Admin always uses the ADMIN_* creds above.
# STAFF_ADMIN_EMAIL=staff@nutrigreenz.farm
# STAFF_ADMIN_PASSCODE=change-me-staff-passcode

# --- Admin phone-OTP sign-in (advanced phone auth) ---
# Firebase Admin SDK (SERVER-ONLY) — verifies the ID token from admin phone-OTP.
# Firebase console → Project settings → Service accounts → Generate new private
# key. Keep FIREBASE_PRIVATE_KEY quoted with its literal \n escapes; the app
# restores real newlines. Never commit these. If unset, phone sign-in returns 503.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Operator phone allowlist (E.164). Passing OTP is not enough — only these
# numbers are granted admin access. ADMIN_PHONE → "superadmin"; STAFF_ADMIN_PHONE
# → "admin" (optional). Unknown numbers are rejected (403, fail closed).
ADMIN_PHONE=+91XXXXXXXXXX
# STAFF_ADMIN_PHONE=+91XXXXXXXXXX

# --- Captain field tool (/captain) ---
# Signs the httpOnly `ng_captain` session cookie that gates /captain/*. If unset,
# it falls back to ADMIN_SESSION_SECRET, so a single-secret deployment works with
# no extra config; set a distinct value to scope captain sessions independently.
# Captains sign in with Firebase phone-OTP (reuses the FIREBASE_PROJECT_ID above);
# only numbers registered as ACTIVE captains in the admin portal are accepted.
# CAPTAIN_SESSION_SECRET=generate-a-long-random-string

# Where customer replies to order emails should land. Falls back to the Brevo
# sender, which is a sending identity rather than a monitored inbox.
REPLY_TO_EMAIL=nutrigreenzfarm@gmail.com

# The address PRINTED in customer emails. customersupport@nutrigreenz.farm has
# no MX record yet, so mail to it bounces - point this at a live mailbox.
SUPPORT_EMAIL=nutrigreenzfarm@gmail.com

# FSSAI licence number (14 digits), shown on the storefront trust badge.
# Public by design — it is a mandatory public disclosure for a food business.
NEXT_PUBLIC_FSSAI_LIC=
